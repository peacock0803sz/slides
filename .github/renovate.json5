{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>peacock0803sz/renovate-config',
  ],
  // 過去の登壇資料 (talks/) は当時の状態で固定する
  ignorePaths: [
    '**/node_modules/**',
    'talks/**',
  ],
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    minimumReleaseAge: null,
  },
  packageRules: [
    {
      matchManagers: [
        'nix',
      ],
      groupName: 'nix flake inputs',
      commitMessagePrefix: ':snowflake:',
      commitMessageAction: 'Update',
      commitMessageTopic: 'flake.lock',
      commitMessageExtra: '',
      group: {
        commitMessageTopic: 'flake.lock',
        commitMessageExtra: '',
      },
    },
    {
      description: 'pnpm lock maintenance uses pnpm-lock.yaml title',
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'lockFileMaintenance',
      ],
      commitMessagePrefix: ':package:',
      commitMessageAction: 'Update',
      commitMessageTopic: 'pnpm-lock.yaml',
      commitMessageExtra: '',
    },
  ],
}
